  "default_hidden": [
    "hilar_connective_tissue_window",
    "mediastinal_fat_window"
  ],
  "physiology_timeline": [
    {
      "frame": 1,
      "label": "Two-lung ventilation"
    },
    {
      "frame": 192,
      "label": "OLV: right lung collapsing"
    },
    {
      "frame": 312,
      "label": "Right lung down (operate)"
    },
    {
      "frame": 432,
      "label": "RML bronchus clamped: RUL+RLL re-inflate"
    },
    {
      "frame": 600,
      "label": "Clamp released"
    }
