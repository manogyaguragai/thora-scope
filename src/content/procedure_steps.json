{
  "version": "v3",
  "fps": 24,
  "heart_rate_bpm": 75,
  "resp_rate_per_min": 15,
  "state_to_morph": {
    "collapse_RUL": "deflate_RUL",
    "collapse_RML": "deflate_RML",
    "collapse_RLL": "deflate_RLL",
    "mediastinal_shift": "max(deflate_RUL,deflate_RML,deflate_RLL)",
    "retract_posterior": "retract_posterior",
    "retract_fissure": "retract_fissure",
    "heartbeat": "heartbeat (0 diastole..1 systole)",
