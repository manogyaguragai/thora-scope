{
  "name": "thorascope",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "perf:probe": "node scripts/perf-probe.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "check": "npm run lint && npm test && npm run build && npm run test:e2e && npm run perf:probe"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "lucide": "1.66.0",
    "three": "0.187.0",
    "three-mesh-bvh": "0.9.18"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.1",
    "@types/three": "0.187.0",
    "draco3dgltf": "1.5.9",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "meshoptimizer": "1.3.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
